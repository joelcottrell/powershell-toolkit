      "Type": "DWord",
      "Value": 1
    },
    {
      "RelativePath": "Software\\Microsoft\\Clipboard",
      "Name": "CloudClipboardAutomaticUpload",
      "Type": "DWord",
      "Value": 1
    }
  ],
  "AppUpdates": {
